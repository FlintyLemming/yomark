    <string name="rule_desc_card">13 to 19 digits passing the Luhn check.</string>
    <string name="rule_desc_iban">Length and check digits verified per country.</string>
    <string name="rule_desc_ssn">US SSN like 123-45-6789; never-issued ranges don\'t count.</string>
    <string name="rule_desc_mac">Like AA:BB:CC:DD:EE:FF.</string>
    <string name="rule_desc_email">Addresses with a common domain suffix.</string>
    <string name="rule_desc_phone">Parsed with regional number rules; starred mobile numbers count too. Digits next to “order” or “order no.” don\'t.</string>
    <string name="rule_desc_passport">The MRZ at the bottom of passports and ID cards, plus numbers beside or below fields like “Passport No.”.</string>
    <string name="rule_desc_apikey">Long random strings starting with sk-, ghp_, AKIA, eyJ and the like.</string>
    <string name="rule_desc_name">Names after fields like “Recipient”, “Name” or “Ship to”, before a phone number, in “Hi David,” or “Mr. Patel”, and under “Surname” / “Given names” on IDs. Without a field name they are guessed and need evidence.</string>
    <string name="rule_desc_address">Text after fields like “Shipping address” or “Deliver to”; addresses with street numbers, buildings or rooms; English street, city and postcode; the place of birth on IDs.</string>
    <string name="rule_desc_pickup">Codes after fields like “Pickup code”.</string>
    <string name="rule_desc_url">Only the path and query are masked; the domain stays.</string>
    <string name="rule_desc_ip">IPv4 and IPv6. Version numbers after “v” or “version” don\'t count.</string>
    <string name="rule_desc_tracking">UPS numbers are check-digit verified; the rest are 12, 15, 20 or 22 plain digits and may be false positives.</string>
    <string name="rule_desc_longnum">16+ digits matching no other kind, such as transaction or order numbers. No check digit, may be false positives.</string>
    <string name="rule_desc_datetime">Dates and times, including “Feb 5, 1965” and “05 FEB 1965”. Dates of birth are a separate kind.</string>
    <string name="rule_desc_birthdate">Dates after or under fields like “Date of birth” or “DOB”, and the birth date from a passport MRZ.</string>

