    <string name="rule_desc_card">13 to 19 digits passing the Luhn check, plus the code after “CVV” and the month/year after “VALID THRU” on a card</string>
    <string name="rule_desc_iban">Length and check digits verified per country</string>
    <string name="rule_desc_ssn">US SSN like 123-45-6789; never-issued ranges don\'t count</string>
    <string name="rule_desc_mac">Like AA:BB:CC:DD:EE:FF</string>
    <string name="rule_desc_email">Addresses with a common domain suffix</string>
    <string name="rule_desc_phone">Parsed with regional number rules; starred mobile numbers count too; digits next to “order” or “order no.” don\'t</string>
    <string name="rule_desc_passport">The MRZ on passports and ID cards, plus numbers beside or below fields like “Passport No.”; the MRZ\'s document number is masked wherever it\'s printed again</string>
    <string name="rule_desc_idnumber">Chinese ID numbers checked by region, birth date and check digit; numbers after fields like “证件号码”, “证号” or “ID No.”; the MRZ on Mainland travel permits and its number elsewhere; Hong Kong, Taiwan, Singapore, Korean and Malaysian IDs, Japanese residence cards and CPF; some need the page to name the country</string>
    <string name="rule_desc_vin">17-character VINs whose check digit matches, plus values after fields like “车辆识别代号”, “VIN” or “Engine No.”</string>
    <string name="rule_desc_apikey">Long random strings starting with sk-, ghp_, AKIA, eyJ and the like</string>
    <string name="rule_desc_name">Names after or under fields like “Recipient”, “姓名/Name”, “Surname” or “Ship to”, before a phone number, in “Hi David,” or “Mr. Patel”, the pinyin under a name on travel permits, and unlabelled names on Chinese and Hong Kong ID cards and diplomas; without a field name they are guessed and need evidence</string>
    <string name="rule_desc_address">Text after fields like “Shipping address” or “Deliver to” and the lines it wraps onto; addresses with street numbers, buildings or rooms; English street, city and postcode; the place of birth on IDs; addresses on Chinese ID cards whose field names didn\'t scan</string>
    <string name="rule_desc_pickup">Codes after or under fields like “Pickup code”, plus the code in Chinese parcel texts like “凭 3-2-1234 取件”</string>
    <string name="rule_desc_plate">Plates in a distinctive format (mainland China, Japan, UK, France, Italy, Russia, India, Brazil and more) and plates after fields like “License plate”, two-row plates included; other formats, such as German or Spanish, only after a field name</string>
    <string name="rule_desc_url">Only the path and query are masked; the domain stays</string>
    <string name="rule_desc_ip">IPv4 and IPv6; version numbers after “v” or “version” don\'t count</string>
    <string name="rule_desc_longnum">Strings of 8+ digits, possibly with hyphens and capital letters, such as tracking or order numbers; no check digit, may be false positives</string>
    <string name="rule_desc_datetime">Dates and times, including “Feb 5, 1965” and “05 FEB 1965”; dates of birth are a separate kind</string>
    <string name="rule_desc_birthdate">Dates after or under fields like “Date of birth” or “DOB”, including year-month only, ROC and Japanese era years; dates matching the birth date in a passport MRZ or a Chinese ID number; dates followed by “生” on diplomas</string>

