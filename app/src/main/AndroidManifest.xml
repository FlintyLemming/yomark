<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      本文件只声明 INTERNET，没有任何运行期权限。合并进来的几条（Play Billing、AICore、androidx 自定义的接收器权限）
      都不授予数据访问能力，合并结果由 :app:assertNoRuntimePermissions 逐条断言。

      INTERNET 给实验室里的外部模型用：AI 增强识别改用用户自己配置的大模型时，把识别出的文字发过去
      （docs/superpowers/specs/2026-10-15-yomark-lab-external-model-design.md）。原先承诺的「运行期网络请求数 = 0」
      2026-10-15 去掉了；除了它和设置页的「测试连接」，本应用不发任何网络请求。系统层面没法在运行时关掉这条权限，
      所以下面把 ML Kit 的遥测单独堵上。

      ACCESS_NETWORK_STATE 是 ML Kit 的遥测后端合并进来的，本应用用不到，照旧摘掉。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".YomarkApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yomark"
        android:enableOnBackInvokedCallback="true">
        <!--
          ML Kit（bundled 变体，模型随包发行、识别全程离线）传递依赖到
          com.google.android.datatransport:transport-backend-cct —— GMS 的遥测上报后端，只用于把使用统计回传 Google。
          原先靠摘掉 INTERNET 挡住它；现在有了网络权限，就把它的后端登记摘掉：datatransport 找不到后端，事件不发、直接丢掉。
          不要改成 exclude 掉 datatransport 那几个 artifact：ML Kit 的日志代码直接引用了它们的类，摘掉会在初始化时 NoClassDefFoundError。
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>
        <!--
          enableOnBackInvokedCallback：预见式返回。Android 16 起 targetSdk 36 默认就开，
          写明是为了 Android 13–15 也走 OnBackInvokedCallback，返回手势拖动时能预览上一页。
          前提是各页都不拦系统返回（不注册常开的 BackHandler），返回交给 Activity 自己 finish。
        -->

        <!-- 首页：启动器入口 -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          编辑器：首页选图后进来，或作为分享目标。
          输入法弹起来时界面自己让（imePadding，见 EditorScreen），系统别再把整个窗口往上推：
          文本的面板一长出来就要输入框拿焦点，那一下输入框还在低处，被推上去的窗口之后不会落回来。
        -->
        <activity
            android:name=".ui.EditorActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          替别的应用选图时的编辑器：还是 EditorActivity，换一个不导出的入口。
          导出时把图交回调用方（而不是存进相册）只认这个入口，别的应用直接打开编辑器走不到这条路。
        -->
        <activity-alias
            android:name=".ui.EditorForCaller"
            android:targetActivity=".ui.EditorActivity"
            android:exported="false" />

        <!--
          别的应用来要图（ACTION_PICK / GET_CONTENT），比如 Telegram 附件相册页右上角的「在外部应用中打开」。
          先拉起系统的选图界面，选好了进编辑器，打好码交回去（见 ui/pick/PickImageActivity）。
          透明主题：它自己什么都不画，选图界面直接盖在调用方上面。
        -->
        <activity
            android:name=".ui.pick.PickImageActivity"
            android:exported="true"
            android:theme="@style/Theme.Yomark.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <!-- 老写法 Intent(ACTION_PICK, MediaStore.Images.Media.EXTERNAL_CONTENT_URI) 解析出来的类型 -->
                <data android:mimeType="vnd.android.cursor.dir/image" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 交给别的应用的图从这里读（见 export/FileProviderSink） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <!-- 设置「帮助」里重新放一遍首次引导（见 ui/onboarding/TourActivity） -->
        <activity
            android:name=".ui.onboarding.TourActivity"
            android:exported="false" />

        <!-- 买成后的感谢页：首页或编辑器在前台时放（见 ui/thanks/ThanksActivity） -->
        <activity
            android:name=".ui.thanks.ThanksActivity"
            android:exported="false" />

        <!-- 设置一级页以下的各页共用一个 Activity，打开哪一页由 intent 里的参数决定 -->
        <activity
            android:name=".ui.settings.SettingsPageActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity" />
    </application>
</manifest>
